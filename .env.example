# Copy this file to .env and fill in values as needed. Never commit .env.
#
# STEP 1/2 have no external API keys (no X API, no OpenAI/Anthropic/Gemini
# API) -- these are placeholders for optional local overrides only.

# Override where config/ and data/ are resolved from (defaults to repo root).
# ECHO_CONFIG_DIR=./config
# ECHO_DATA_DIR=./data

# Override the SQLite database file location (defaults to ./data/echo.db).
# ECHO_DATABASE_PATH=./data/echo.db

# Minimum OpportunityScore.final_score required to proceed past the
# threshold check into CREATE (defaults to 0.5).
# ECHO_SCORE_THRESHOLD=0.5

# STEP 2: where `echo ingest --fixture` / STATIC_FIXTURE sources read their
# local JSON fixtures from (defaults to ./tests/fixtures/sources).
# ECHO_FIXTURES_DIR=./tests/fixtures/sources

# STEP 2: a handful of the most likely-to-need-tuning trend signal knobs.
# See docs/SOURCE_INTELLIGENCE.md and echo.trend.signal_config for the
# full set (most are code-level defaults, not env-configurable).
# ECHO_FRESHNESS_HALF_LIFE_HOURS=6.0
# ECHO_VELOCITY_SATURATION=6.0
# ECHO_NOVELTY_SIMILARITY_THRESHOLD=0.6
# ECHO_CLUSTER_SIMILARITY_THRESHOLD=0.35

# Pre-Commit Hardening: a TrendCandidate with novelty below this is a
# near-exact repeat of an already-persisted trend and is not written to
# the `trends` table again (it is still detected and shown -- see
# docs/SOURCE_INTELLIGENCE.md "Trend persistence guard").
# ECHO_TREND_PERSISTENCE_NOVELTY_THRESHOLD=0.10

# Per-source ingestion upper bounds (max_items_per_fetch, max_item_age_hours)
# are set in config/sources/<vertical>.yaml, not here -- see
# echo.source.config.SourceConfig and docs/SOURCE_INTELLIGENCE.md
# "Ingestion upper bounds".
